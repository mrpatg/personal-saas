{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name. Change this when you reuse the template for a new site.
  "name": "personal-saas",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      // Code reads the database as env.DB
      "binding": "DB",
      "database_name": "personal-saas-db",
      // Replace with the id printed by `npx wrangler d1 create personal-saas-db`.
      // Local dev works without a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
