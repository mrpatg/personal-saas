# Local secrets for `npm run dev` / `wrangler dev`.
# Copy this file to .dev.vars (which git ignores) and fill in real values.
# In production, set each one with: npx wrangler secret put <NAME>
#
# Better Auth: signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Stripe (online invoice payments). Use test-mode keys (sk_test_…) locally.
# Without STRIPE_SECRET_KEY the "Pay now" button is hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email). Without it, emails are skipped and logged instead of sent.
RESEND_API_KEY=
