---
/**
 * HTML shell shared by every page: <head>, theme variables, fonts.
 * Use PublicLayout for marketing pages and AppLayout for signed-in screens.
 */
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  /** Page title; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Hide from search engines (sign-in and private pages). */
  noindex?: boolean;
}

const { title, description = site.tagline, noindex = false } = Astro.props;
const siteTitle = `${site.owner} ${site.name}`;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const themeVars = [
  `--site-primary: ${site.colors.primary}`,
  `--site-primary-foreground: ${site.colors.primaryForeground}`,
  `--site-canvas: ${site.colors.canvas}`,
  `--site-ink: ${site.colors.ink}`,
].join('; ');
---

<!doctype html>
<html lang="en" style={themeVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.colors.canvas} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-dvh bg-canvas print:bg-white font-sans text-ink antialiased selection:bg-primary/15">
    <slot />
  </body>
</html>
