---
/**
 * Asks Better Auth to email a reset link. Always shows the same confirmation,
 * so the page never reveals whether an email address has an account.
 */
import AuthShell from '../components/AuthShell.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';
import { getAuth } from '../lib/auth';
import { field } from '../lib/auth-helpers';
import { emailEnabled } from '../lib/email';

let sent = false;
let email = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = field(form, 'email');
  if (email) {
    try {
      await getAuth().api.requestPasswordReset({ body: { email, redirectTo: '/reset-password' }, headers: Astro.request.headers });
    } catch (err) {
      console.error('Password reset request failed', err);
    }
    sent = true;
  }
}

const input =
  'mt-1.5 block h-12 w-full rounded-2xl bg-canvas px-4 text-[15px] ring-1 ring-line transition outline-none placeholder:text-muted/70 focus:ring-2 focus:ring-primary';
---

<AuthShell title="Forgot password">
  <h1 class="font-display text-4xl">Forgot your password?</h1>
  {sent ? (
    <>
      <p role="status" class="mt-6 rounded-2xl bg-primary-soft px-4 py-3 text-sm text-primary">
        If there's an account for <span class="font-medium break-all">{email}</span>, we've sent it a link to choose a new password. Check your inbox (and spam folder).
      </p>
      <p class="mt-8 text-sm text-muted"><a href="/login" class="text-primary hover:underline">Back to sign in</a></p>
    </>
  ) : emailEnabled() ? (
    <>
      <p class="mt-2 text-muted">Enter your email and we'll send you a link to choose a new one.</p>
      <form method="post" class="mt-8 space-y-5">
        <label class="block text-sm font-medium">
          Email
          <input type="email" name="email" value={email} autocomplete="email" required placeholder="you@company.com" class={input} />
        </label>
        <Button type="submit" size="lg" class="w-full">Email me a link</Button>
      </form>
      <p class="mt-8 text-center text-sm text-muted"><a href="/login" class="text-primary hover:underline">Back to sign in</a></p>
    </>
  ) : (
    <>
      <p class="mt-4 leading-relaxed text-muted">
        Get in touch at <a href={`mailto:${site.contactEmail}?subject=Password%20reset`} class="text-primary hover:underline">{site.contactEmail}</a> and we'll reset it for you.
      </p>
      <p class="mt-8 text-sm text-muted"><a href="/login" class="text-primary hover:underline">Back to sign in</a></p>
    </>
  )}
</AuthShell>
