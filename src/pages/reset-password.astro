---
/**
 * Choose a new password from an emailed link (?token=…). The same page
 * welcomes new clients when the link came from an invite (?invite=1).
 */
import { isAPIError } from 'better-auth/api';
import AuthShell from '../components/AuthShell.astro';
import Button from '../components/ui/Button.astro';
import { getAuth } from '../lib/auth';
import { authErrorMessage } from '../lib/auth-helpers';

const token = Astro.url.searchParams.get('token') ?? '';
const invite = Astro.url.searchParams.get('invite') === '1';
let error = '';
let expired = !token;

if (Astro.request.method === 'POST' && token) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < 10) error = 'Use at least 10 characters.';
  else if (password !== confirm) error = 'The two passwords don’t match.';
  else {
    try {
      await getAuth().api.resetPassword({ body: { token, newPassword: password }, headers: Astro.request.headers });
      return Astro.redirect(`/login?done=${invite ? 'welcome' : 'reset'}`, 303);
    } catch (err) {
      if (isAPIError(err) && /token/i.test(err.message)) expired = true;
      else error = authErrorMessage(err);
    }
  }
  Astro.response.status = 400;
}

const input =
  'mt-1.5 block h-12 w-full rounded-2xl bg-canvas px-4 text-[15px] ring-1 ring-line transition outline-none placeholder:text-muted/70 focus:ring-2 focus:ring-primary';
---

<AuthShell title={invite ? 'Set your password' : 'Choose a new password'}>
  {expired ? (
    <>
      <h1 class="font-display text-4xl">This link has expired</h1>
      <p class="mt-4 leading-relaxed text-muted">Links work once and only for a limited time. Request a fresh one and it'll arrive in a minute.</p>
      <div class="mt-8"><Button href="/forgot-password" size="lg" class="w-full">Send me a new link</Button></div>
    </>
  ) : (
    <>
      <h1 class="font-display text-4xl">{invite ? 'Set your password' : 'Choose a new password'}</h1>
      <p class="mt-2 text-muted">{invite ? 'Welcome! Pick a password to finish setting up your account.' : 'You’ll use it the next time you sign in.'}</p>
      {error && <p role="alert" class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{error}</p>}
      <form method="post" class="mt-8 space-y-5">
        <label class="block text-sm font-medium">
          New password
          <input type="password" name="password" autocomplete="new-password" minlength="10" required class={input} />
          <span class="mt-1.5 block text-xs font-normal text-muted">At least 10 characters.</span>
        </label>
        <label class="block text-sm font-medium">
          Confirm password
          <input type="password" name="confirm" autocomplete="new-password" minlength="10" required class={input} />
        </label>
        <Button type="submit" size="lg" class="w-full">{invite ? 'Set password' : 'Save new password'}</Button>
      </form>
    </>
  )}
</AuthShell>
