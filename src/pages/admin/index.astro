---
/** Admin home: a quick summary and shortcuts. */
import { and, eq, sql, type SQL } from 'drizzle-orm';
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { adminNav } from '../../lib/nav';
import { ROLES } from '../../lib/auth';
import { getDb, schema } from '../../db';
import { formatMoney } from '../../lib/work';
import { outstanding } from '../../lib/invoices';
import { recentActivity } from '../../lib/activity';
import ActivityList from '../../components/ActivityList.astro';

const user = Astro.locals.user!; // guaranteed by src/middleware.ts
const db = getDb();
const count = (where: SQL | undefined) =>
  db.select({ n: sql<number>`count(*)` }).from(schema.user).where(where).get().then((r) => r?.n ?? 0);
const [clients, disabled, activeProjects] = await Promise.all([
  count(eq(schema.user.role, ROLES.client)),
  count(and(eq(schema.user.role, ROLES.client), eq(schema.user.banned, true))),
  db.select({ n: sql<number>`count(*)` }).from(schema.project).where(eq(schema.project.status, 'active')).get().then((r) => r?.n ?? 0),
]);
const owed = await outstanding();
const { rows: latest } = await recentActivity({ limit: 6 });
---

<AppLayout title="Admin" nav={adminNav} active="/admin" user={{ name: user.name, company: 'Admin' }} signOut>
  <p class="text-sm text-muted">Admin</p>
  <h1 class="font-display text-4xl sm:text-5xl">Hello, {user.name.split(' ')[0]}</h1>

  <div class="mt-8 grid grid-cols-2 gap-3 sm:max-w-2xl sm:grid-cols-3 sm:gap-4">
    <Card>
      <p class="text-sm text-muted">Active clients</p>
      <p class="mt-2 font-display text-4xl">{clients - disabled}</p>
    </Card>
    <Card>
      <p class="text-sm text-muted">Disabled</p>
      <p class="mt-2 font-display text-4xl">{disabled}</p>
    </Card>
    <Card>
      <p class="text-sm text-muted">Active projects</p>
      <p class="mt-2 font-display text-4xl">{activeProjects}</p>
    </Card>
    <a href="/admin/invoices?status=open" class="col-span-2 block rounded-3xl transition hover:-translate-y-0.5 sm:col-span-3">
      <Card>
        <p class="text-sm text-muted">Outstanding invoices</p>
        <p class="mt-2 font-display text-4xl">{formatMoney(owed.dueCents)}</p>
        {owed.overdueCents > 0 && <p class="mt-1 text-sm text-rose-700">{formatMoney(owed.overdueCents)} overdue</p>}
      </Card>
    </a>
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    <Button href="/admin/projects">Manage projects</Button>
    <Button href="/admin/invoices" variant="secondary">Invoices</Button>
    <Button href="/admin/clients" variant="secondary">Manage clients</Button>
  </div>

  <section class="mt-12 max-w-3xl">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl">Recent activity</h2>
      <a href="/admin/activity" class="text-sm text-primary hover:underline">See all</a>
    </div>
    <ActivityList rows={latest} links class="mt-4" />
  </section>
</AppLayout>
