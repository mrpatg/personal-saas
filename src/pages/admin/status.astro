---
/**
 * Admin: system status. Checks the database, migrations, sign-in, email,
 * Stripe and the webhook, and recent problems, each with a fix when needed.
 * The same data is at /admin/status.json.
 */
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { adminNav } from '../../lib/nav';
import { formatWhen } from '../../lib/activity';
import { overall, runChecks, type CheckState } from '../../lib/status';

const admin = Astro.locals.user!; // guaranteed by src/middleware.ts
const checks = await runChecks(Astro.url.origin);
const state = overall(checks);
const checkedAt = formatWhen(new Date());

const look: Record<CheckState, { dot: string; label: string }> = {
  ok: { dot: 'bg-emerald-500', label: 'Working' },
  warn: { dot: 'bg-amber-500', label: 'Needs a look' },
  fail: { dot: 'bg-rose-600', label: 'Not working' },
  off: { dot: 'bg-line', label: 'Off' },
};
const headline = { ok: 'Everything is working', warn: 'Working, with something to look at', fail: 'Something needs fixing', off: '' }[state];
---

<AppLayout title="Status" nav={adminNav} active="/admin" user={{ name: admin.name, company: 'Admin' }} signOut>
  <a href="/admin" class="text-sm text-muted hover:text-ink">← Overview</a>
  <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl sm:text-5xl">Status</h1>
      <p class="mt-2 flex items-start gap-2 text-muted">
        <span class={`mt-2 h-2.5 w-2.5 shrink-0 rounded-full ${look[state].dot}`} aria-hidden="true"></span>
        {headline} · checked {checkedAt}
      </p>
    </div>
    <Button href="/admin/status" variant="secondary" size="sm">Check again</Button>
  </div>

  <Card padded={false} class="mt-8 max-w-3xl overflow-hidden">
    <ul class="divide-y divide-line">
      {checks.map((c) => (
        <li class="flex gap-4 px-5 py-4 sm:px-7" data-check={c.id} data-state={c.state}>
          <span class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${look[c.state].dot}`} aria-hidden="true"></span>
          <div class="min-w-0 text-sm">
            <p class="font-medium">{c.label} <span class="font-normal text-muted">· {look[c.state].label}</span></p>
            <p class="mt-0.5 break-words text-muted">{c.detail}</p>
            {c.fix && c.state !== 'ok' && <p class="mt-1 break-words text-ink">To fix: {c.fix}</p>}
          </div>
        </li>
      ))}
    </ul>
  </Card>

  <p class="mt-6 max-w-3xl text-sm text-muted">
    Code changes are covered by automated tests that run on every pull request (see <code>tests/</code>). This page checks the live setup: keys, domains and services.{' '}
    <a href="/admin/status.json" class="text-primary hover:underline">View as JSON</a>
  </p>
</AppLayout>
