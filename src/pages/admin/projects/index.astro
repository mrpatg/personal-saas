---
/**
 * Admin: every project, optionally filtered to one client (?client=<id>),
 * plus a form to start a new project for a client.
 */
import AppLayout from '../../../layouts/AppLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import StatusBadge from '../../../components/ui/StatusBadge.astro';
import ProgressBar from '../../../components/ui/ProgressBar.astro';
import { inputClass, selectClass, textareaClass } from '../../../components/ui/forms';
import { adminNav } from '../../../lib/nav';
import { field } from '../../../lib/auth-helpers';
import { allProjects, clientOptions, formatDate, parseDate, projectStatus } from '../../../lib/projects';
import { getDb, schema } from '../../../db';
import Avatar from '../../../components/ui/Avatar.astro';
import { logActivity } from '../../../lib/activity';

const admin = Astro.locals.user!; // guaranteed by src/middleware.ts
const clientFilter = Astro.url.searchParams.get('client') || undefined;
const clients = await clientOptions();

let error = '';
let draft = { clientId: clientFilter ?? '', name: '', description: '', startDate: '', dueDate: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  draft = {
    clientId: field(form, 'clientId'),
    name: field(form, 'name'),
    description: field(form, 'description'),
    startDate: field(form, 'startDate'),
    dueDate: field(form, 'dueDate'),
  };
  if (!clients.some((c) => c.id === draft.clientId)) error = 'Choose a client.';
  else if (!draft.name) error = 'Give the project a name.';
  else {
    const id = crypto.randomUUID();
    await getDb()
      .insert(schema.project)
      .values({
        id,
        clientId: draft.clientId,
        name: draft.name,
        description: draft.description || null,
        startDate: parseDate(draft.startDate),
        dueDate: parseDate(draft.dueDate),
      })
      .run();
    const client = clients.find((c) => c.id === draft.clientId);
    await logActivity(admin, { action: 'project.created', subjectType: 'project', subjectId: id, clientId: draft.clientId, summary: `Created project “${draft.name}” for ${client?.name ?? 'a client'}` }, Astro.request);
    return Astro.redirect(`/admin/projects/${id}?created=1`, 303);
  }
  Astro.response.status = 400;
}

const projects = await allProjects(clientFilter);
const filteredClient = clientFilter ? clients.find((c) => c.id === clientFilter) : undefined;
const clientLabel = (c: { name: string; company: string | null }) => (c.company ? `${c.name} (${c.company})` : c.name);
---

<AppLayout title="Projects" nav={adminNav} active="/admin/projects" user={{ name: admin.name, company: 'Admin' }} signOut>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-muted">Admin</p>
      <h1 class="font-display text-4xl sm:text-5xl">Projects</h1>
    </div>
    <Button href="#new-project" variant="secondary">New project</Button>
  </div>

  {error && <p role="alert" class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{error}</p>}

  {clients.length > 0 && (
    <form method="get" class="mt-8 flex flex-wrap items-end gap-2">
      <label class="block min-w-0 flex-1 text-sm font-medium sm:max-w-xs">
        Client
        <select name="client" class={selectClass} onchange="this.form.submit()">
          <option value="">All clients</option>
          {clients.map((c) => <option value={c.id} selected={c.id === clientFilter}>{clientLabel(c)}</option>)}
        </select>
      </label>
      <noscript><Button type="submit" variant="secondary">Filter</Button></noscript>
    </form>
  )}

  <section class="mt-6">
    {projects.length === 0 ? (
      <Card>
        <p class="text-muted">
          {filteredClient ? `No projects for ${filteredClient.name} yet.` : 'No projects yet.'}{' '}
          {clients.length === 0 ? <>Add a client on the <a href="/admin/clients" class="text-primary hover:underline">Clients</a> page first.</> : 'Start one below.'}
        </p>
      </Card>
    ) : (
      <ul class="grid gap-4 xl:grid-cols-2">
        {projects.map((p) => (
          <li class="min-w-0">
            <a href={`/admin/projects/${p.id}`} class="block h-full rounded-3xl transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-primary">
              <Card class="h-full">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex min-w-0 items-center gap-3">
                    <Avatar name={p.name} src={p.image} size="md" shape="square" />
                    <div class="min-w-0">
                      <p class="font-semibold tracking-tight">{p.name}</p>
                      <p class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
                        <Avatar name={p.clientName} src={p.clientImage} size="xs" />
                        <span class="truncate">{p.clientName}{p.clientCompany ? ` · ${p.clientCompany}` : ''}</span>
                      </p>
                    </div>
                  </div>
                  <StatusBadge tone={projectStatus[p.status].tone}>{projectStatus[p.status].label}</StatusBadge>
                </div>
                <ProgressBar
                  class="mt-5"
                  percent={p.counts.percent}
                  label={`${p.counts.done} of ${p.counts.total} tasks done${p.dueDate ? ` · Due ${formatDate(p.dueDate)}` : ''}`}
                />
              </Card>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  {clients.length > 0 && (
    <section id="new-project" class="mt-12 scroll-mt-24">
      <Card class="max-w-2xl">
        <h2 class="font-display text-3xl">New project</h2>
        <p class="mt-1 text-sm text-muted">The client sees it in their portal right away. You can add tasks next.</p>
        <form method="post" class="mt-6 grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium sm:col-span-2">
            Client
            <select name="clientId" required class={selectClass}>
              <option value="" disabled selected={!draft.clientId}>Choose a client</option>
              {clients.map((c) => <option value={c.id} selected={c.id === draft.clientId}>{clientLabel(c)}</option>)}
            </select>
          </label>
          <label class="block text-sm font-medium sm:col-span-2">
            Project name
            <input name="name" value={draft.name} required maxlength="200" autocomplete="off" class={inputClass} />
          </label>
          <label class="block text-sm font-medium sm:col-span-2">
            Description <span class="font-normal text-muted">(optional, the client sees this)</span>
            <textarea name="description" rows="3" maxlength="4000" class={textareaClass}>{draft.description}</textarea>
          </label>
          <label class="block text-sm font-medium">
            Start date <span class="font-normal text-muted">(optional)</span>
            <input type="date" name="startDate" value={draft.startDate} class={inputClass} />
          </label>
          <label class="block text-sm font-medium">
            Due date <span class="font-normal text-muted">(optional)</span>
            <input type="date" name="dueDate" value={draft.dueDate} class={inputClass} />
          </label>
          <div class="sm:col-span-2">
            <Button type="submit">Create project</Button>
          </div>
        </form>
      </Card>
    </section>
  )}
</AppLayout>
