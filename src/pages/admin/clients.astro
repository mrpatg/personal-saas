---
/**
 * Admin: client accounts. Add a client, edit their details and photo, reset
 * a password, disable or re-enable an account. Forms post back here and call Better Auth's admin
 * API with the admin's own session, so its permission checks apply too.
 */
import { asc, eq } from 'drizzle-orm';
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { adminNav } from '../../lib/nav';
import { getAuth, PASSWORD_LINK_HOURS, ROLES, sendPasswordLink } from '../../lib/auth';
import { emailEnabled } from '../../lib/email';
import { authErrorMessage, field, generatePassword } from '../../lib/auth-helpers';
import { getDb, schema } from '../../db';
import { logActivity } from '../../lib/activity';
import { inputClass } from '../../components/ui/forms';
import Avatar from '../../components/ui/Avatar.astro';
import ImageInput from '../../components/ImageInput.astro';
import { applyImageChange, readImageField } from '../../lib/media';

/** A validation problem in the edit form; shown inside the Edit pop-up. */
class EditError extends Error {}

const admin = Astro.locals.user!; // guaranteed by src/middleware.ts
const db = getDb();
const headers = Astro.request.headers;
const logClient = (action: string, target: { id: string }, summary: string) =>
  logActivity(admin, { action, summary, subjectType: 'client', subjectId: target.id, clientId: target.id }, Astro.request);

const input = inputClass;

/** Shown once after creating a client or resetting a password. */
let credentials: { title: string; email: string; password: string } | null = null;
let notice = '';
let error = '';
let draft = { name: '', company: '', email: '' };
/** The client being edited when saving failed, with what was typed. */
let editDraft: { id: string; name: string; company: string; email: string } | null = null;
let editError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = field(form, 'intent');
  try {
    if (intent === 'create') {
      draft = { name: field(form, 'name'), company: field(form, 'company'), email: field(form, 'email') };
      const invite = emailEnabled() && form.get('invite') === 'on';
      // With an invite, the client picks their own password; this random one is never shown.
      const password = (invite ? '' : field(form, 'password')) || generatePassword(4);
      const { user: newClient } = await getAuth().api.createUser({
        headers,
        body: {
          name: draft.name,
          email: draft.email,
          password,
          role: ROLES.client,
          data: { company: draft.company || null },
        },
      });
      await logClient('client.created', newClient, `Created a client account for ${draft.name} (${newClient.email})`);
      if (invite) {
        const sent = await sendPasswordLink(draft.email, 'invite', headers);
        await logClient(sent.ok ? 'client.invited' : 'client.invite_failed', newClient, sent.ok ? `Emailed an invite to ${newClient.email}` : `Invite email to ${newClient.email} failed: ${sent.error}`);
        if (sent.ok) notice = `Invite sent to ${draft.email}. They'll choose their own password from the email.`;
        else {
          // Fall back to a password the admin can pass on by hand.
          const fallback = generatePassword();
          const created = await db.select().from(schema.user).where(eq(schema.user.email, draft.email.toLowerCase())).get();
          if (created) await getAuth().api.setUserPassword({ headers, body: { userId: created.id, newPassword: fallback } });
          error = `The account was created, but the invite email failed (${sent.error}). Send them the details below instead.`;
          credentials = { title: `${draft.name} can now sign in`, email: draft.email.toLowerCase(), password: fallback };
        }
      } else {
        credentials = { title: `${draft.name} can now sign in`, email: draft.email.toLowerCase(), password };
      }
      draft = { name: '', company: '', email: '' };
    } else {
      // Every other action targets an existing client (never an admin).
      const target = await db.select().from(schema.user).where(eq(schema.user.id, field(form, 'userId'))).get();
      if (!target || target.role !== ROLES.client) throw new Error('Client not found.');

      if (intent === 'update-client') {
        editDraft = { id: target.id, name: field(form, 'name'), company: field(form, 'company'), email: field(form, 'email').toLowerCase() };
        const { name, company, email } = editDraft;
        const image = readImageField(form);
        if (!name) throw new EditError('Enter their name.');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new EditError('Enter a valid email address.');
        if (image.kind === 'error') throw new EditError(image.message);
        if (email !== target.email) {
          const taken = await db.select({ id: schema.user.id }).from(schema.user).where(eq(schema.user.email, email)).get();
          if (taken) throw new EditError('Another account already uses that email.');
        }
        const quote = (v: string | null) => (v ? `“${v}”` : 'blank');
        const changes: string[] = [];
        if (name !== target.name) changes.push(`name ${quote(target.name)} → ${quote(name)}`);
        if ((company || null) !== (target.company || null)) changes.push(`company ${quote(target.company)} → ${quote(company || null)}`);
        if (email !== target.email) changes.push(`email ${target.email} → ${email}`);
        const newImage = await applyImageChange(image, target.image, { type: 'user', id: target.id }, admin.id);
        if (newImage !== undefined) changes.push(newImage ? (target.image ? 'changed photo' : 'added photo') : 'removed photo');
        if (changes.length === 0) notice = 'No changes to save.';
        else {
          await db
            .update(schema.user)
            .set({ name, company: company || null, email, ...(newImage !== undefined ? { image: newImage } : {}) })
            .where(eq(schema.user.id, target.id))
            .run();
          await logClient('client.updated', target, `Updated ${target.name}’s details: ${changes.join('; ')}`);
          notice = `Saved changes to ${name}.`;
        }
        editDraft = null;
      } else if (intent === 'send-link') {
        // Never signed in yet -> invite wording; otherwise a normal reset email.
        const session = await db.select({ id: schema.session.id }).from(schema.session).where(eq(schema.session.userId, target.id)).limit(1).get();
        const everSignedIn = Boolean(session);
        const sent = await sendPasswordLink(target.email, everSignedIn ? 'reset' : 'invite', headers);
        if (sent.ok) {
          notice = `${everSignedIn ? 'Password reset link' : 'Invite'} emailed to ${target.email}.`;
          await logClient(everSignedIn ? 'client.reset_link' : 'client.invited', target, `Emailed ${everSignedIn ? 'a password reset link' : 'an invite'} to ${target.email}`);
        }
        else throw new Error(`EMAIL:${sent.error}`);
      } else if (intent === 'reset-password') {
        const password = field(form, 'password') || generatePassword();
        await getAuth().api.setUserPassword({ headers, body: { userId: target.id, newPassword: password } });
        await getAuth().api.revokeUserSessions({ headers, body: { userId: target.id } });
        credentials = { title: `New password for ${target.name}`, email: target.email, password };
        await logClient('client.password_set', target, `Set a new password for ${target.name} and signed them out`);
      } else if (intent === 'disable') {
        await getAuth().api.banUser({ headers, body: { userId: target.id, banReason: 'Disabled by admin' } });
        notice = `${target.name}'s account is disabled and they have been signed out.`;
        await logClient('client.disabled', target, `Disabled ${target.name}’s account`);
      } else if (intent === 'enable') {
        await getAuth().api.unbanUser({ headers, body: { userId: target.id } });
        notice = `${target.name}'s account is active again.`;
        await logClient('client.enabled', target, `Re-enabled ${target.name}’s account`);
      } else {
        throw new Error('Unknown action.');
      }
    }
  } catch (err) {
    if (err instanceof EditError) editError = err.message;
    else if (err instanceof Error && err.message === 'Client not found.') error = err.message;
    else if (err instanceof Error && err.message.startsWith('EMAIL:')) error = `The email couldn't be sent: ${err.message.slice(6)}`;
    else error = authErrorMessage(err);
    Astro.response.status = 400;
  }
}

const clients = await db
  .select()
  .from(schema.user)
  .where(eq(schema.user.role, ROLES.client))
  .orderBy(asc(schema.user.name))
  .all();

const mailOn = emailEnabled();
// Reopen the Add client pop-up when creating failed (keeps what was typed), or via ?add=1.
const openAdd = (Astro.request.method === 'POST' && draft.name && Astro.response.status === 400) || Astro.url.searchParams.has('add');
const plusIcon = 'M12 5v14M5 12h14';
// The Edit pop-up: reopened after a failed save, or opened by an Edit link (?edit=<id>).
const editSource = editDraft ? clients.find((c) => c.id === editDraft!.id) : clients.find((c) => c.id === Astro.url.searchParams.get('edit'));
const editing = editSource
  ? { ...editSource, ...(editDraft ? { name: editDraft.name, company: editDraft.company, email: editDraft.email } : {}) }
  : null;
if (editError && !editing) error = editError;
const editFormKey = editing ? `${editing.id}-${Date.now()}` : '';
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<AppLayout title="Clients" nav={adminNav} active="/admin/clients" user={{ name: admin.name, company: 'Admin' }} signOut>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-muted">Admin</p>
      <h1 class="font-display text-4xl sm:text-5xl">Clients</h1>
    </div>
    <Button href="?add=1" data-open-dialog="add-client" aria-haspopup="dialog">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d={plusIcon} /></svg>
      Add client
    </Button>
  </div>

  {error && !openAdd && <p role="alert" class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{error}</p>}
  {notice && <p role="status" class="mt-6 rounded-2xl bg-primary-soft px-4 py-3 text-sm text-primary">{notice}</p>}

  {credentials && (
    <Card class="mt-6 ring-2! ring-primary!">
      <h2 class="font-display text-2xl">{credentials.title}</h2>
      <p class="mt-1 text-sm text-muted">Send these details to the client. The password is only shown once.</p>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-[auto_1fr] sm:gap-x-6">
        <dt class="text-muted">Sign-in page</dt>
        <dd class="font-medium break-all">{new URL('/login', Astro.url).href}</dd>
        <dt class="text-muted">Email</dt>
        <dd class="font-medium break-all">{credentials.email}</dd>
        <dt class="text-muted">Temporary password</dt>
        <dd class="font-mono text-base font-semibold tracking-wide">{credentials.password}</dd>
      </dl>
    </Card>
  )}

  <!-- Client list -->
  <section class="mt-10">
    {clients.length === 0 ? (
      <Card>
        <p class="text-muted">No clients yet. <a href="?add=1" data-open-dialog="add-client" class="text-primary hover:underline">Add your first one</a>.</p>
      </Card>
    ) : (
      <ul class="space-y-3">
        {clients.map((c) => (
          <li id={`client-${c.id}`} class="scroll-mt-24">
            <Card>
              <div class="flex items-start gap-4">
                <Avatar name={c.name} src={c.image} size="md" />
                <div class="min-w-0 flex-1">
                  <p class="font-semibold tracking-tight">{c.name}</p>
                  <p class="text-sm text-muted">{c.company || 'No company'}</p>
                  <p class="mt-1 text-sm break-all">{c.email}</p>
                  <p class="mt-1 text-xs text-muted">Added {dateFmt.format(c.createdAt)}</p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  {c.banned ? <StatusBadge tone="danger">Disabled</StatusBadge> : <StatusBadge tone="success">Active</StatusBadge>}
                  <a href={`?edit=${c.id}`} class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm text-primary transition hover:bg-primary-soft" aria-label={`Edit ${c.name}`}>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                    Edit
                  </a>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-line/70 pt-4">
                <details class="group">
                  <summary class="inline-flex h-9 cursor-pointer list-none items-center rounded-full px-4 text-sm ring-1 ring-line transition hover:ring-primary/40">
                    Reset password
                  </summary>
                  <form method="post" class="mt-3 flex flex-wrap items-end gap-2">
                    <input type="hidden" name="intent" value="reset-password" />
                    <input type="hidden" name="userId" value={c.id} />
                    <label class="block text-sm">
                      <span class="text-muted">New password (blank = generate one)</span>
                      <input type="text" name="password" minlength="10" autocomplete="off" class={`${input} w-64`} />
                    </label>
                    <Button type="submit" size="sm">Set password</Button>
                  </form>
                </details>
                {mailOn && !c.banned && (
                  <form method="post">
                    <input type="hidden" name="intent" value="send-link" />
                    <input type="hidden" name="userId" value={c.id} />
                    <Button type="submit" size="sm" variant="ghost">Email a password link</Button>
                  </form>
                )}
                <Button href={`/admin/projects?client=${c.id}`} size="sm" variant="ghost">Projects</Button>
                <form method="post">
                  <input type="hidden" name="userId" value={c.id} />
                  {c.banned ? (
                    <Button type="submit" size="sm" variant="ghost" name="intent" value="enable">Re-enable</Button>
                  ) : (
                    <Button type="submit" size="sm" variant="ghost" name="intent" value="disable" class="text-rose-700!">Disable</Button>
                  )}
                </form>
              </div>
            </Card>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- Add client (pop-up; opened by the "Add client" button) -->
  <dialog
    id="add-client"
    aria-labelledby="add-client-title"
    data-autoopen={openAdd ? '' : undefined}
    open={openAdd}
    class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-3xl bg-surface p-0 text-ink shadow-lift ring-1 ring-line backdrop:bg-ink/40 backdrop:backdrop-blur-sm"
  >
    <div class="p-6 sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <h2 id="add-client-title" class="font-display text-3xl">Add a client</h2>
        <form method="dialog">
          <button type="submit" formnovalidate class="-m-2 rounded-full p-2 text-muted transition hover:bg-primary-soft hover:text-ink" aria-label="Close">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </form>
      </div>
      {error && openAdd && <p role="alert" class="mt-4 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{error}</p>}
      <p class="mt-1 text-sm text-muted">
        {mailOn ? 'They get an email to choose their own password, or you can set one and send it yourself.' : 'They can sign in right away with the email and password you give them.'}
      </p>
      <form method="post" class="mt-6 grid gap-4 sm:grid-cols-2">
        <input type="hidden" name="intent" value="create" />
        <label class="block text-sm font-medium">
          Name
          <input name="name" value={draft.name} required autocomplete="off" class={input} />
        </label>
        <label class="block text-sm font-medium">
          Company <span class="font-normal text-muted">(optional)</span>
          <input name="company" value={draft.company} autocomplete="off" class={input} />
        </label>
        <label class="block text-sm font-medium sm:col-span-2">
          Email
          <input type="email" name="email" value={draft.email} required autocomplete="off" class={input} />
        </label>
        {mailOn && (
          <label class="flex items-start gap-2 text-sm sm:col-span-2">
            <input type="checkbox" name="invite" checked class="mt-0.5 h-4 w-4 accent-primary" />
            <span><span class="font-medium">Email them an invite</span> <span class="text-muted">to choose their own password (the link lasts {PASSWORD_LINK_HOURS / 24} days)</span></span>
          </label>
        )}
        <label class="block text-sm font-medium sm:col-span-2">
          Temporary password <span class="font-normal text-muted">({mailOn ? 'only used without an invite; ' : ''}leave blank to generate one)</span>
          <input type="text" name="password" minlength="10" autocomplete="off" class={input} />
        </label>
        <div class="flex flex-wrap gap-3 sm:col-span-2">
          <Button type="submit">Create client account</Button>
          <Button type="submit" variant="ghost" formmethod="dialog" formnovalidate>Cancel</Button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Edit client (pop-up; opened by a client's Edit link) -->
  {editing && (
    <dialog
      id="edit-client"
      data-modal
      data-autoopen
      open
      aria-labelledby="edit-client-title"
      class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-3xl bg-surface p-0 text-ink shadow-lift ring-1 ring-line backdrop:bg-ink/40 backdrop:backdrop-blur-sm"
    >
      <div class="p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <h2 id="edit-client-title" class="font-display text-3xl">Edit client</h2>
          <form method="dialog">
            <button type="submit" formnovalidate class="-m-2 rounded-full p-2 text-muted transition hover:bg-primary-soft hover:text-ink" aria-label="Close">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </form>
        </div>
        {editError && <p role="alert" class="mt-4 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{editError}</p>}
        <form method="post" enctype="multipart/form-data" class="mt-6 grid gap-4 sm:grid-cols-2" data-key={editFormKey}>
          <input type="hidden" name="intent" value="update-client" />
          <input type="hidden" name="userId" value={editing.id} />
          <div class="sm:col-span-2">
            <ImageInput label="Photo" src={editing.image} fallbackName={editing.name} />
          </div>
          <label class="block text-sm font-medium">
            Name
            <input name="name" value={editing.name} required autocomplete="off" class={input} />
          </label>
          <label class="block text-sm font-medium">
            Company <span class="font-normal text-muted">(optional)</span>
            <input name="company" value={editing.company ?? ''} autocomplete="off" class={input} />
          </label>
          <label class="block text-sm font-medium sm:col-span-2">
            Email <span class="font-normal text-muted">(they sign in with this)</span>
            <input type="email" name="email" value={editing.email} required autocomplete="off" class={input} />
          </label>
          <div class="flex flex-wrap gap-3 sm:col-span-2">
            <Button type="submit">Save changes</Button>
            <Button type="submit" variant="ghost" formmethod="dialog" formnovalidate>Cancel</Button>
          </div>
        </form>
      </div>
    </dialog>
  )}
</AppLayout>

<script>
  // Pop-ups: links with data-open-dialog="<id>" open that dialog in place (their href still works
  // without JavaScript). A dialog the server rendered open (data-autoopen) becomes a proper modal.
  for (const el of document.querySelectorAll<HTMLElement>('[data-open-dialog]')) {
    el.addEventListener('click', (e) => {
      const dialog = document.getElementById(el.dataset.openDialog!) as HTMLDialogElement | null;
      if (!dialog) return;
      e.preventDefault();
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('input:not([type=hidden]):not([type=file])')?.focus();
    });
  }
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog')) {
    if (dialog.hasAttribute('data-autoopen')) {
      dialog.close();
      dialog.showModal();
    }
    // Clicking the dimmed backdrop closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Drop ?add=1 / ?edit=… so a refresh doesn't reopen it.
    dialog.addEventListener('close', () => {
      if (/[?&](add|edit)=/.test(location.search)) history.replaceState(null, '', location.pathname);
    });
  }
</script>
