---
import PublicLayout from '../layouts/PublicLayout.astro';
import Button from '../components/ui/Button.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import { site } from '../config/site';
---

<PublicLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 pt-16 pb-14 text-center sm:px-8 sm:pt-24 sm:pb-20">
      <p class="inline-flex rounded-full bg-surface px-4 py-1.5 text-xs font-medium tracking-wide text-muted ring-1 ring-line">
        {site.home.eyebrow}
      </p>
      <h1 class="mt-6 font-display text-5xl leading-[1.05] tracking-tight text-balance sm:text-7xl">
        {site.home.headline}
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-pretty text-muted">{site.home.intro}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={site.cta.href} size="lg" class="w-full sm:w-auto">{site.cta.label}</Button>
        <Button href={`mailto:${site.contactEmail}`} variant="secondary" size="lg" class="w-full sm:w-auto">Start a project</Button>
      </div>
    </div>

    <!-- Product glimpse -->
    <div class="relative mx-auto max-w-4xl px-5 pb-20 sm:px-8">
      <div class="rounded-[2rem] bg-surface p-3 shadow-lift ring-1 ring-line sm:p-4">
        <div class="rounded-[1.5rem] bg-canvas p-5 sm:p-8">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-xs font-medium tracking-wide text-muted uppercase">Active project</p>
              <p class="mt-1 font-display text-3xl">Patient intake app</p>
            </div>
            <StatusBadge tone="progress">On track</StatusBadge>
          </div>
          <div class="mt-6 h-2 overflow-hidden rounded-full bg-line">
            <div class="h-full w-[64%] rounded-full bg-primary"></div>
          </div>
          <ul class="mt-6 grid gap-2 text-sm sm:grid-cols-3">
            <li class="flex items-center justify-between rounded-2xl bg-surface px-4 py-3 ring-1 ring-line">Intake form <StatusBadge tone="success">Done</StatusBadge></li>
            <li class="flex items-center justify-between rounded-2xl bg-surface px-4 py-3 ring-1 ring-line">Scheduling API <StatusBadge tone="progress">Active</StatusBadge></li>
            <li class="flex items-center justify-between rounded-2xl bg-surface px-4 py-3 ring-1 ring-line">Invoice #1042 <StatusBadge tone="warning">Due</StatusBadge></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="border-t border-line bg-surface/60">
    <div class="mx-auto grid max-w-6xl gap-4 px-5 py-16 sm:grid-cols-3 sm:gap-6 sm:px-8 sm:py-20">
      {site.home.highlights.map((h, i) => (
        <div class="rounded-3xl bg-canvas p-7 ring-1 ring-line">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-medium text-primary-foreground">{i + 1}</span>
          <h2 class="mt-5 font-display text-2xl">{h.title}</h2>
          <p class="mt-2 leading-relaxed text-muted">{h.body}</p>
        </div>
      ))}
    </div>
  </section>
</PublicLayout>
