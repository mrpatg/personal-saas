---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout>
  <section class="mx-auto max-w-2xl py-16 text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-accent">{site.owner}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{site.name}</h1>
    <p class="mt-4 text-lg text-slate-600">{site.tagline}</p>
    <p class="mt-2 text-slate-500">{site.description}</p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href={`mailto:${site.contactEmail}`}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:opacity-90"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
