---
/**
 * Sign-in screen. The form posts back to this page, which signs in with
 * Better Auth on the server (works without JavaScript) and redirects each
 * role to its own area.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';
import { getAuth, homeFor } from '../lib/auth';
import { authErrorMessage, field, redirectWithCookies, safeRedirect } from '../lib/auth-helpers';
import { getDb, schema } from '../db';

const nextParam = Astro.url.searchParams.get('next');

// Already signed in: go straight to the right area.
if (Astro.locals.user) return Astro.redirect(safeRedirect(nextParam, homeFor(Astro.locals.user)));

// Fresh install with no accounts yet: create the first admin instead.
const anyUser = await getDb().select({ id: schema.user.id }).from(schema.user).limit(1).get();
if (!anyUser) return Astro.redirect('/setup');

let error = '';
let email = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = field(form, 'email');
  const password = form.get('password');
  try {
    const { headers, response } = await getAuth().api.signInEmail({
      body: { email, password: typeof password === 'string' ? password : '', rememberMe: true },
      headers: Astro.request.headers,
      returnHeaders: true,
    });
    return redirectWithCookies(safeRedirect(nextParam, homeFor(response.user)), headers);
  } catch (err) {
    error = authErrorMessage(err, 'Sign-in failed. Please try again.');
    Astro.response.status = 401;
  }
}

const input =
  'mt-1.5 block h-12 w-full rounded-2xl bg-canvas px-4 text-[15px] ring-1 ring-line transition outline-none placeholder:text-muted/70 focus:ring-2 focus:ring-primary';
---

<BaseLayout title="Sign in" noindex>
  <div class="grid min-h-dvh lg:grid-cols-2">
    <!-- Brand panel (desktop) -->
    <aside class="relative hidden overflow-hidden bg-primary p-12 text-primary-foreground lg:flex lg:flex-col lg:justify-between">
      <div class="absolute -right-24 -bottom-24 h-96 w-96 rounded-full bg-white/5" aria-hidden="true"></div>
      <div class="absolute -top-16 -left-16 h-64 w-64 rounded-full bg-white/5" aria-hidden="true"></div>
      <p class="relative text-sm tracking-wide opacity-80">{site.owner}</p>
      <div class="relative">
        <p class="font-display text-5xl leading-tight">{site.home.headline}</p>
        <p class="mt-4 max-w-md opacity-80">{site.tagline}</p>
      </div>
      <p class="relative text-sm opacity-60">{site.contactEmail}</p>
    </aside>

    <!-- Form -->
    <main class="flex flex-col px-5 py-8 sm:px-8">
      <Logo />
      <div class="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center py-12">
        <h1 class="font-display text-4xl">Welcome back</h1>
        <p class="mt-2 text-muted">Sign in to see your projects and invoices.</p>

        {error && (
          <p role="alert" class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{error}</p>
        )}

        <form method="post" class="mt-8 space-y-5">
          <label class="block text-sm font-medium">
            Email
            <input type="email" name="email" value={email} autocomplete="email" required placeholder="you@company.com" class={input} />
          </label>
          <label class="block text-sm font-medium">
            <span class="flex justify-between">
              Password
              <a href={`mailto:${site.contactEmail}?subject=Password%20reset`} class="font-normal text-primary hover:underline">Forgot?</a>
            </span>
            <input type="password" name="password" autocomplete="current-password" required class={input} />
          </label>
          <Button type="submit" size="lg" class="w-full">Sign in</Button>
        </form>

        <p class="mt-8 text-center text-sm text-muted">
          New client? Accounts are set up by invitation.<br />
          <a href={`mailto:${site.contactEmail}`} class="text-primary hover:underline">Get in touch</a>
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
