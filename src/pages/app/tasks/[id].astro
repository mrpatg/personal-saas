---
/** Client: one task on one of their projects, with its comment thread. */
import { and, eq, inArray } from 'drizzle-orm';
import AppLayout from '../../../layouts/AppLayout.astro';
import StatusBadge from '../../../components/ui/StatusBadge.astro';
import CommentThread from '../../../components/CommentThread.astro';
import { clientNav } from '../../../lib/nav';
import { field } from '../../../lib/auth-helpers';
import { CLIENT_VISIBLE_STATUSES, taskStatus } from '../../../lib/projects';
import { addComment, taskComments } from '../../../lib/work';
import { getDb, schema } from '../../../db';

const user = Astro.locals.user!; // guaranteed by src/middleware.ts
const id = Astro.params.id ?? '';

// Only tasks on the signed-in client's own, non-archived projects; anything else is a 404.
const row = await getDb()
  .select({ task: schema.task, project: schema.project })
  .from(schema.task)
  .innerJoin(schema.project, eq(schema.task.projectId, schema.project.id))
  .where(
    and(
      eq(schema.task.id, id),
      eq(schema.project.clientId, user.id),
      inArray(schema.project.status, CLIENT_VISIBLE_STATUSES),
    ),
  )
  .get();
if (!row) return new Response('Task not found', { status: 404 });
const { task, project } = row;

let error = '';
let draft = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (field(form, 'intent') !== 'comment') error = 'Unknown action.';
  else {
    draft = field(form, 'body');
    error = (await addComment(id, user.id, draft)) ?? '';
  }
  if (!error) return Astro.redirect(`/app/tasks/${id}#comments`, 303);
  Astro.response.status = 400;
}

const comments = await taskComments(id);
---

<AppLayout title={task.title} nav={clientNav} active="/app/projects" user={{ name: user.name, company: user.company ?? undefined }} signOut>
  <a href={`/app/projects/${project.id}`} class="text-sm text-muted hover:text-ink">← {project.name}</a>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <h1 class="min-w-0 font-display text-4xl break-words sm:text-5xl">{task.title}</h1>
    <StatusBadge tone={taskStatus[task.status].tone}>{taskStatus[task.status].label}</StatusBadge>
  </div>
  {task.notes && <p class="mt-4 max-w-2xl leading-relaxed whitespace-pre-line">{task.notes}</p>}

  {error && <p role="alert" class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">{error}</p>}

  <div class="mt-10 max-w-3xl">
    <CommentThread comments={comments} viewerId={user.id} draft={draft} placeholder="Ask a question or share feedback on this task…" />
  </div>
</AppLayout>
