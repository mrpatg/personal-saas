---
/** Client: one of their invoices, ready to read, print or save as PDF. */
import { and, eq, inArray } from 'drizzle-orm';
import AppLayout from '../../../layouts/AppLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import InvoiceDocument from '../../../components/InvoiceDocument.astro';
import { clientNav } from '../../../lib/nav';
import { formatDate } from '../../../lib/projects';
import { formatMoney } from '../../../lib/work';
import { CLIENT_INVOICE_STATUSES, displayStatus, invoiceLines, invoiceName, invoiceNumber } from '../../../lib/invoices';
import { logActivity, loggedRecently } from '../../../lib/activity';
import { ROLES } from '../../../lib/auth';
import { getDb, schema } from '../../../db';
import { site } from '../../../config/site';
import { field } from '../../../lib/auth-helpers';
import { inBackground } from '../../../lib/email';
import { notifyPaymentReceived } from '../../../lib/notify';
import { applyCheckoutSession, checkoutUrlFor, getCheckoutSession, PaymentError, stripeEnabled } from '../../../lib/stripe';

const user = Astro.locals.user!; // guaranteed by src/middleware.ts

// Only the signed-in client's own non-draft invoices; anything else is a 404.
const row = await getDb()
  .select({ invoice: schema.invoice, projectName: schema.project.name })
  .from(schema.invoice)
  .leftJoin(schema.project, eq(schema.invoice.projectId, schema.project.id))
  .where(
    and(
      eq(schema.invoice.id, Astro.params.id ?? ''),
      eq(schema.invoice.clientId, user.id),
      inArray(schema.invoice.status, CLIENT_INVOICE_STATUSES),
    ),
  )
  .get();
if (!row) return new Response('Invoice not found', { status: 404 });
let inv = row.invoice;
let error = '';
let notice = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (field(form, 'intent') === 'pay' && stripeEnabled()) {
    let url = '';
    try {
      url = await checkoutUrlFor(inv, user.email, Astro.url.origin);
      await logActivity(user, { action: 'invoice.checkout', summary: `Opened the Stripe payment page for ${invoiceNumber(inv)}`, subjectType: 'invoice', subjectId: inv.id, clientId: inv.clientId }, Astro.request);
    } catch (err) {
      console.error('Checkout failed', err);
      error = err instanceof PaymentError ? err.message : 'We couldn’t start the payment. Please try again in a moment.';
      // Keep Stripe's own reason for the admin (invoice History, Activity and Status pages).
      if (!(err instanceof PaymentError))
        await logActivity(
          user,
          { action: 'invoice.checkout_failed', summary: `Couldn’t start a Stripe payment for ${invoiceNumber(inv)}: ${err instanceof Error ? err.message : String(err)}`, subjectType: 'invoice', subjectId: inv.id, clientId: inv.clientId },
          Astro.request,
        );
    }
    if (url) return Astro.redirect(url, 303);
  }
  if (!error) return Astro.redirect(`/app/invoices/${inv.id}`, 303);
  Astro.response.status = 400;
}

// Back from Stripe: confirm the payment right away instead of waiting for the webhook.
const checkout = Astro.url.searchParams.get('checkout');
const sessionId = Astro.url.searchParams.get('session_id');
if (checkout === 'done' && sessionId && stripeEnabled()) {
  try {
    const session = await getCheckoutSession(sessionId);
    if (session.metadata?.invoice_id === inv.id) {
      const result = await applyCheckoutSession(session);
      if (result) {
        inv = result.invoice;
        if (result.newlyPaid) await inBackground(Astro.locals, notifyPaymentReceived(result.invoice, Astro.url.origin));
      }
      notice = session.payment_status === 'paid'
        ? 'Thank you! Your payment went through and a receipt is on its way.'
        : 'Thank you! Your payment is processing. Bank payments can take a few days to clear; this page will show Paid once it does.';
    }
  } catch (err) {
    console.error('Could not confirm checkout', err);
    notice = 'Thank you! We’re confirming your payment. This page will show Paid shortly.';
  }
} else if (checkout === 'cancelled') {
  notice = 'Payment cancelled. Nothing was charged.';
}

// Record when the client opens the invoice (at most once an hour, and not the admin previewing it).
if (Astro.request.method === 'GET' && user.role === ROLES.client && !(await loggedRecently(user.id, 'invoice.viewed', inv.id, 60))) {
  await logActivity(user, { action: 'invoice.viewed', summary: `Viewed ${invoiceNumber(inv)}`, subjectType: 'invoice', subjectId: inv.id, clientId: inv.clientId }, Astro.request);
}

const lines = await invoiceLines(inv.id);
const status = displayStatus(inv);
const canPay = stripeEnabled() && (status === 'sent' || status === 'overdue');
---

<AppLayout title={invoiceName(inv)} nav={clientNav} active="/app/invoices" user={{ name: user.name, company: user.company ?? undefined }} signOut>
  <a href="/app/invoices" class="text-sm text-muted hover:text-ink print:hidden">← All invoices</a>
  {error && <p role="alert" class="mt-4 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800 print:hidden">{error}</p>}
  {notice && <p role="status" class="mt-4 rounded-2xl bg-primary-soft px-4 py-3 text-sm text-primary print:hidden">{notice}</p>}

  <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_300px]">
    <InvoiceDocument invoice={inv} lines={lines} projectName={row.projectName} />

    <div class="order-first print:hidden lg:order-none lg:sticky lg:top-24 lg:self-start">
      <Card>
        {status === 'paid' ? (
          <>
            <p class="text-sm text-muted">Paid</p>
            <p class="mt-1 font-display text-5xl">{formatMoney(inv.totalCents)}</p>
            <p class="mt-1 text-sm text-muted">Received {formatDate(inv.paidDate)}. Thank you!</p>
          </>
        ) : status === 'void' ? (
          <>
            <p class="text-sm text-muted">Void</p>
            <p class="mt-1 text-sm">This invoice was cancelled and nothing is owed on it.</p>
          </>
        ) : (
          <>
            <p class="text-sm text-muted">Amount due</p>
            <p class="mt-1 font-display text-5xl">{formatMoney(inv.totalCents)}</p>
            <p class={`mt-1 text-sm ${status === 'overdue' ? 'font-medium text-rose-700' : 'text-muted'}`}>
              {status === 'overdue' ? 'Overdue since' : 'Due'} {formatDate(inv.dueDate)}
            </p>
            {canPay && (
              <form method="post" class="mt-6">
                <input type="hidden" name="intent" value="pay" />
                <Button type="submit" size="lg" class="w-full">Pay now</Button>
                <p class="mt-3 text-center text-xs text-muted">Secure payment by Stripe</p>
              </form>
            )}
            {site.billing.paymentInstructions && <p class="mt-4 text-sm leading-relaxed whitespace-pre-line text-muted">{site.billing.paymentInstructions}</p>}
          </>
        )}
        <div class="mt-6 border-t border-line pt-5">
          <Button variant="secondary" size="sm" class="w-full" onclick="window.print()">Print or save as PDF</Button>
        </div>
      </Card>
    </div>
  </div>
</AppLayout>
