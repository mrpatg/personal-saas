---
/** Client: their own projects (archived ones are hidden). Read-only. */
import AppLayout from '../../../layouts/AppLayout.astro';
import Card from '../../../components/ui/Card.astro';
import ProjectSummaryCard from '../../../components/ProjectSummaryCard.astro';
import { clientNav } from '../../../lib/nav';
import { clientProjects } from '../../../lib/projects';
import { site } from '../../../config/site';

const user = Astro.locals.user!; // guaranteed by src/middleware.ts
const projects = await clientProjects(user.id);
---

<AppLayout title="Projects" nav={clientNav} active="/app/projects" user={{ name: user.name, company: user.company ?? undefined }} signOut>
  <h1 class="font-display text-4xl sm:text-5xl">Projects</h1>

  {projects.length === 0 ? (
    <Card class="mt-8 max-w-2xl">
      <h2 class="font-display text-2xl">No projects yet</h2>
      <p class="mt-2 leading-relaxed text-muted">
        Once work is underway you'll see each project and its progress here. Questions in the meantime? Write to{' '}
        <a href={`mailto:${site.contactEmail}`} class="text-primary hover:underline">{site.contactEmail}</a>.
      </p>
    </Card>
  ) : (
    <ul class="mt-8 grid gap-5 xl:grid-cols-2">
      {projects.map((p) => (
        <li><ProjectSummaryCard project={p} href={`/app/projects/${p.id}`} /></li>
      ))}
    </ul>
  )}
</AppLayout>
