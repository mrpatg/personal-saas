---
/** Client: one of their projects with its task list. Read-only. */
import { and, eq, inArray } from 'drizzle-orm';
import AppLayout from '../../../layouts/AppLayout.astro';
import Card from '../../../components/ui/Card.astro';
import StatusBadge from '../../../components/ui/StatusBadge.astro';
import ProgressBar from '../../../components/ui/ProgressBar.astro';
import { clientNav } from '../../../lib/nav';
import { CLIENT_VISIBLE_STATUSES, countsFrom, formatDate, projectStatus, projectTasks, taskStatus } from '../../../lib/projects';
import CommentCount from '../../../components/CommentCount.astro';
import { commentCounts } from '../../../lib/work';
import { getDb, schema } from '../../../db';

const user = Astro.locals.user!; // guaranteed by src/middleware.ts

// Only the signed-in client's own, non-archived projects. Anything else is a 404,
// so clients can't tell whether another client's project exists.
const project = await getDb()
  .select()
  .from(schema.project)
  .where(
    and(
      eq(schema.project.id, Astro.params.id ?? ''),
      eq(schema.project.clientId, user.id),
      inArray(schema.project.status, CLIENT_VISIBLE_STATUSES),
    ),
  )
  .get();
if (!project) return new Response('Project not found', { status: 404 });

const tasks = await projectTasks(project.id);
const comments = await commentCounts(tasks.map((t) => t.id));
const counts = countsFrom(tasks.length, tasks.filter((t) => t.status === 'done').length);
const dates = [
  project.startDate && `Started ${formatDate(project.startDate)}`,
  project.dueDate && `Target ${formatDate(project.dueDate)}`,
].filter(Boolean).join(' · ');
---

<AppLayout title={project.name} nav={clientNav} active="/app/projects" user={{ name: user.name, company: user.company ?? undefined }} signOut>
  <a href="/app/projects" class="text-sm text-muted hover:text-ink">← All projects</a>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <h1 class="min-w-0 font-display text-4xl break-words sm:text-5xl">{project.name}</h1>
    <StatusBadge tone={projectStatus[project.status].tone}>{projectStatus[project.status].label}</StatusBadge>
  </div>
  {dates && <p class="mt-2 text-sm text-muted">{dates}</p>}
  {project.description && <p class="mt-4 max-w-2xl leading-relaxed whitespace-pre-line">{project.description}</p>}

  <ProgressBar class="mt-6 max-w-xl" percent={counts.percent} label={`${counts.done} of ${counts.total} tasks done · ${counts.percent}%`} />

  <section class="mt-10">
    <h2 class="font-display text-3xl">Tasks</h2>
    {tasks.length === 0 ? (
      <Card class="mt-5"><p class="text-muted">The task list for this project is being put together.</p></Card>
    ) : (
      <Card class="mt-5 overflow-hidden" padded={false}>
        <ul class="divide-y divide-line">
          {tasks.map((t) => (
            <li>
              <a href={`/app/tasks/${t.id}`} class="flex items-start justify-between gap-3 px-5 py-4 transition hover:bg-primary-soft/50 sm:px-7">
                <div class="min-w-0">
                  <p class={`break-words ${t.status === 'done' ? 'text-muted line-through decoration-line' : 'font-medium'}`}>{t.title}</p>
                  {t.notes && <p class="mt-0.5 line-clamp-2 text-sm text-muted">{t.notes}</p>}
                </div>
                <div class="flex shrink-0 items-center gap-3">
                  <CommentCount count={comments.get(t.id) ?? 0} />
                  <StatusBadge tone={taskStatus[t.status].tone}>{taskStatus[t.status].label}</StatusBadge>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </Card>
    )}
  </section>
</AppLayout>
