---
/** Design preview: a single invoice with sample data. */
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { site } from '../../config/site';
import { sampleUser, sampleInvoiceDetail as inv, invoiceStatus, money, previewNav, previewNotice } from '../../data/sample';

const subtotal = inv.lines.reduce((s, l) => s + l.qty * l.unit, 0);
const status = invoiceStatus[inv.status];
---

<AppLayout title={`Invoice ${inv.id}`} nav={previewNav} active="/preview/invoice" user={sampleUser} notice={previewNotice}>
  <a href="/preview/dashboard" class="inline-flex items-center gap-1 text-sm text-muted transition hover:text-ink">
    <span aria-hidden="true">←</span> Back to overview
  </a>

  <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_320px]">
    <Card class="sm:p-10!">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-sm text-muted">{inv.id}</p>
          <h1 class="mt-1 font-display text-4xl">{inv.title}</h1>
        </div>
        <StatusBadge tone={status.tone}>{status.label}</StatusBadge>
      </div>

      <dl class="mt-8 grid grid-cols-2 gap-6 text-sm sm:grid-cols-[1.3fr_1fr_auto] sm:gap-8">
        <div class="col-span-2 sm:col-span-1">
          <dt class="text-muted">From</dt>
          <dd class="mt-1 font-medium">{site.owner}</dd>
          <dd class="break-all text-muted">{site.contactEmail}</dd>
        </div>
        <div>
          <dt class="text-muted">Billed to</dt>
          {inv.billTo.map((l, i) => <dd class={i === 0 ? 'mt-1 font-medium' : 'text-muted'}>{l}</dd>)}
        </div>
        <div>
          <dt class="text-muted">Issued</dt>
          <dd class="mt-1">{inv.issued}</dd>
          <dt class="mt-3 text-muted">Due</dt>
          <dd class="mt-1">{inv.due}</dd>
        </div>
      </dl>

      <div class="mt-10">
        <div class="hidden grid-cols-[1fr_60px_90px_100px] gap-4 border-b border-line pb-3 text-xs font-medium tracking-wide text-muted uppercase sm:grid">
          <span>Description</span><span class="text-right">Hours</span><span class="text-right">Rate</span><span class="text-right">Amount</span>
        </div>
        <ul class="divide-y divide-line">
          {inv.lines.map((l) => (
            <li class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 py-4 text-sm sm:grid-cols-[1fr_60px_90px_100px]">
              <span>{l.description}</span>
              <span class="hidden text-right tabular-nums text-muted sm:block">{l.qty}</span>
              <span class="hidden text-right tabular-nums text-muted sm:block">{money(l.unit)}</span>
              <span class="text-right font-medium tabular-nums">{money(l.qty * l.unit)}</span>
              <span class="text-xs text-muted sm:hidden">{l.qty} × {money(l.unit)}</span>
            </li>
          ))}
        </ul>
        <div class="flex justify-end border-t border-line pt-5">
          <dl class="w-full max-w-xs space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-muted">Subtotal</dt><dd class="tabular-nums">{money(subtotal)}</dd></div>
            <div class="flex justify-between"><dt class="text-muted">Tax</dt><dd class="tabular-nums">{money(0)}</dd></div>
            <div class="flex justify-between border-t border-line pt-3 text-base font-semibold"><dt>Total due</dt><dd class="tabular-nums">{money(subtotal)}</dd></div>
          </dl>
        </div>
      </div>

      <p class="mt-10 text-sm text-muted">{inv.notes}</p>
    </Card>

    <!-- Pay panel -->
    <div class="lg:sticky lg:top-24 lg:self-start">
      <Card>
        <p class="text-sm text-muted">Amount due</p>
        <p class="mt-1 font-display text-5xl">{money(subtotal)}</p>
        <p class="mt-1 text-sm text-muted">Due {inv.due}</p>
        <Button size="lg" class="mt-6 w-full">Pay securely</Button>
        <p class="mt-3 text-center text-xs text-muted">Card or bank transfer · Powered by Stripe</p>
        <div class="mt-6 border-t border-line pt-5">
          <Button variant="ghost" size="sm" class="w-full">Download PDF</Button>
        </div>
      </Card>
    </div>
  </div>
</AppLayout>
