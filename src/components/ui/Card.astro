---
/** Soft rounded surface used for panels, list items and forms. */
interface Props {
  class?: string;
  padded?: boolean;
}
const { class: extra = '', padded = true } = Astro.props;
---

<div class={`rounded-3xl bg-surface ring-1 ring-line shadow-soft ${padded ? 'p-5 sm:p-7' : ''} ${extra}`}>
  <slot />
</div>
