---
/** Pill-shaped button or link. Renders <a> when href is given. */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', type = 'button', class: extra = '', ...rest } = Astro.props;
const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition duration-150 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none';
const variants = {
  primary: 'bg-primary text-primary-foreground shadow-soft hover:brightness-110',
  secondary: 'bg-surface text-ink ring-1 ring-line hover:ring-primary/40',
  ghost: 'text-ink hover:bg-primary-soft',
};
const sizes = { sm: 'h-9 px-4 text-sm', md: 'h-11 px-5 text-[15px]', lg: 'h-12 px-7 text-base' };
const cls = `${base} ${variants[variant]} ${sizes[size]} ${extra}`;
---

{href ? <a href={href} class={cls} {...rest}><slot /></a> : <button type={type} class={cls} {...rest}><slot /></button>}
