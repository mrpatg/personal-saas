---
/** Split-screen frame for sign-in, forgot-password and set-password pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from './Logo.astro';
import { site } from '../config/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<BaseLayout title={title} noindex>
  <div class="grid min-h-dvh lg:grid-cols-2">
    <!-- Brand panel (desktop) -->
    <aside class="relative hidden overflow-hidden bg-primary p-12 text-primary-foreground lg:flex lg:flex-col lg:justify-between">
      <div class="absolute -right-24 -bottom-24 h-96 w-96 rounded-full bg-white/5" aria-hidden="true"></div>
      <div class="absolute -top-16 -left-16 h-64 w-64 rounded-full bg-white/5" aria-hidden="true"></div>
      <p class="relative text-sm tracking-wide opacity-80">{site.owner}</p>
      <div class="relative">
        <p class="font-display text-5xl leading-tight">{site.home.headline}</p>
        <p class="mt-4 max-w-md opacity-80">{site.tagline}</p>
      </div>
      <p class="relative text-sm opacity-60">{site.contactEmail}</p>
    </aside>

    <!-- Form -->
    <main class="flex flex-col px-5 py-8 sm:px-8">
      <Logo />
      <div class="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center py-12">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
