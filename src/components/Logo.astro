---
import { site } from '../config/site';
interface Props {
  showName?: boolean;
}
const { showName = true } = Astro.props;
---

<a href="/" class="group flex items-center gap-3" aria-label={`${site.owner} ${site.name} home`}>
  <span
    class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary font-display text-lg text-primary-foreground shadow-soft transition group-hover:brightness-110"
    aria-hidden="true">{site.monogram}</span
  >
  {showName && <span class="text-[15px] font-semibold tracking-tight">{site.name}</span>}
</a>
